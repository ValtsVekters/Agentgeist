# Copy to .env and fill in. Never commit .env.

# Scenario feed MCP server URL (from your team card)
SCENARIO_MCP=

# Team handle used in submit_containment, e.g. team-04
TEAM_HANDLE=

# You.com API key (https://you.com/home)
YDC_API_KEY=

# One API key for escalation via one-mcp (https://hackathon.withone.ai/sf-halloween-2026)
ONE_SECRET=

# Discord escalation channel (#loft-incident)
DISCORD_CHANNEL_ID=1564842098740695100

# LLM provider for CrewAI agents (AWS Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
