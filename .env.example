# Copy to .env and fill in. Never commit .env.
# Variable names follow the hackathon brief. CrewAI needs no key.

# Scenario feed MCP server
SCENARIO_MCP=https://api.you.com/mcp/halloween-hack-26

# Team handle used in submit_containment, e.g. team-04
TEAM_HANDLE=

# You.com: search + contents (grounding) — https://you.com/home
YDC_API_KEY=

# One: managed auth, Discord escalation — https://hackathon.withone.ai/sf-halloween-2026
ONE_API_KEY=

# Parasail: inference + embeddings (OpenAI-compatible, https://api.parasail.io/v1)
PARASAIL_API_KEY=

# Discord escalation channel (#loft-incident)
DISCORD_CHANNEL_ID=1564842098740695100
